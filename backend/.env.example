SOUL_AI_MODE=local
SOUL_MULTI_AGENT_ENABLED=false
# production은 승인된 자료만 검색합니다. 기본 샘플 자료는 제외됩니다.
# NODE_ENV=production인 경우에도 운영 자료 검증이 강제됩니다.
SOUL_CORPUS_MODE=development
# 명시적으로 true면 LLM/embedding 외부 API를 호출하지 않습니다.
SOUL_EXTERNAL_API_DISABLED=false
# 검증된 snapshot과 atomic registry를 저장할 운영 전용 경로
SOUL_PRODUCTION_INDEX_DIR=
# 운영 기본값은 keyword; true는 로컬 hybrid 실험용 override입니다.
SOUL_HYBRID_EXPERIMENTAL=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
PORT=8787
# 쉼표로 구분. 모바일 네이티브 앱은 Origin 헤더가 없을 수 있습니다.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# 설정하면 Flutter도 같은 Bearer 토큰을 보내야 합니다.
APP_BEARER_TOKEN=
LOG_LEVEL=info
