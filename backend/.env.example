SOUL_AI_MODE=local
SOUL_MULTI_AGENT_ENABLED=false
# production은 승인된 자료만 검색합니다. 기본 샘플 자료는 제외됩니다.
# NODE_ENV=production인 경우에도 운영 자료 검증이 강제됩니다.
SOUL_CORPUS_MODE=development
# 명시적으로 true면 LLM/embedding 외부 API를 호출하지 않습니다.
SOUL_EXTERNAL_API_DISABLED=false
# 검증된 snapshot과 atomic registry를 저장할 운영 전용 경로
SOUL_PRODUCTION_INDEX_DIR=
# 운영 기본값은 keyword; true는 로컬 hybrid 실험용 override입니다.
SOUL_HYBRID_EXPERIMENTAL=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
# V1 uses explicit tier IDs; OPENAI_MODEL is used only by the rollback path.
# Legacy tier overrides below are still accepted. Prefer the named V1 settings.
# Configure reviewed models to
# obtain an actual price difference between tiers.
OPENAI_CHEAP_MODEL=
OPENAI_STANDARD_MODEL=
OPENAI_PREMIUM_MODEL=
SOUL_COST_ROUTER_V1_ENABLED=true
OPENAI_LUNA_MODEL=gpt-5.6-luna
OPENAI_TERRA_MODEL=gpt-5.6-terra
OPENAI_SOL_MODEL=gpt-5.6-sol
SOUL_TARGET_SESSION_COST_USD=0.007
SOUL_FREE_DAILY_AI_CALLS=5
SOUL_FREE_DAILY_AI_BUDGET_USD=0.03
SOUL_FREE_PREMIUM_CALLS=0
SOUL_PREMIUM_DAILY_AI_CALLS=50
SOUL_PREMIUM_DAILY_AI_BUDGET_USD=0.30
# Optional monthly overrides default to daily limit * 31 (UTC calendar month).
# SOUL_FREE_MONTHLY_AI_CALLS=155
# SOUL_FREE_MONTHLY_AI_BUDGET_USD=0.93
# SOUL_PREMIUM_MONTHLY_AI_CALLS=1550
# SOUL_PREMIUM_MONTHLY_AI_BUDGET_USD=9.30
# Per-generation reserved USD; unknown usage/prices retain this reservation.
# Empty: tier-aware conservative reservations; explicit values retain old hard limits.
SOUL_AI_REQUEST_RESERVATION_USD=
# Reviewed USD per million tokens: {"model-id":{"input":...,"cachedInput":...,"output":...}}
# Unknown prices remain null; no real model pricing is assumed by the application.
# Empty: reviewed 2026-09-12 Luna/Terra/Sol prices including cache writes.
# Explicit {} means unknown pricing. Sol promotional rate needs review after 2026-11-21.
SOUL_MODEL_PRICING_JSON=
# Runtime defaults to a persistent ledger; memory is an explicit development option.
SOUL_USAGE_LEDGER=sqlite
# Relative paths are resolved from the backend working directory. Keep outside public/.
SOUL_USAGE_DB_PATH=data/ai_usage.sqlite
# Retention must be 32..366 days so pruning cannot reset current-month quota.
SOUL_USAGE_RETENTION_DAYS=62
# Bounded synchronous wait for another SQLite writer (0..5000 ms).
SOUL_USAGE_DB_TIMEOUT_MS=250
PORT=8787
# 쉼표로 구분. 모바일 네이티브 앱은 Origin 헤더가 없을 수 있습니다.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# 설정하면 Flutter도 같은 Bearer 토큰을 보내야 합니다.
APP_BEARER_TOKEN=
LOG_LEVEL=info
# Optional verified member identity. Shared app bearer remains separate.
# Configure a trusted issuer and exactly one JWKS source before enabling.
SOUL_AUTH_ENABLED=false
SOUL_AUTH_REQUIRED=false
SOUL_AUTH_ISSUER=
SOUL_AUTH_AUDIENCE=
SOUL_AUTH_JWKS_URL=
SOUL_AUTH_JWKS_JSON=
SOUL_AUTH_ALGORITHMS=RS256
SOUL_AUTH_JWT_TYP=JWT
SOUL_AUTH_MAX_TOKEN_AGE_SECONDS=3600
SOUL_AUTH_REQUIRED_CLAIMS_JSON={}
# Server-controlled grants: [{"subject":"provider-subject","plan":"premium","expiresAt":"2026-10-01T00:00:00Z"}]
SOUL_AUTH_ENTITLEMENTS_JSON=[]
