{
  "version": "1",
  "tradition": "buddhist",
  "namespace": "buddhism",
  "allowedSourceTypes": [
    "canonical_text",
    "commentary",
    "scholarly",
    "practice_reference"
  ],
  "preferredAuthority": [
    "primary",
    "official",
    "scholarly",
    "secondary"
  ],
  "licenseRequirements": {
    "allowed": [
      "public_domain",
      "official_permission",
      "licensed",
      "self_authored"
    ],
    "noteRequired": true
  },
  "provenanceRequirements": [
    "publisherOrInstitution",
    "sourceUrl",
    "originalLanguage",
    "contentLanguage",
    "importedAt",
    "checksum",
    "sourceVersion"
  ],
  "branchMetadata": {
    "required": true,
    "examples": [
      "general",
      "Theravada",
      "Mahayana",
      "Zen",
      "Tibetan"
    ],
    "allowGeneralForSpecificBranch": false
  },
  "languageMetadata": {
    "originalRequired": true,
    "contentMustMatchRecord": true
  },
  "exclusionCriteria": [
    "sample",
    "unknown_license",
    "unapproved",
    "untraceable",
    "changed_after_review",
    "other_tradition"
  ],
  "reviewRequirement": {
    "productionStatus": "approved",
